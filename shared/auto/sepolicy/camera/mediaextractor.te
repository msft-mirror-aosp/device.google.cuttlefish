allow hal_camera_default fwk_sensor_hwservice:hwservice_manager find;
allow hal_camera_default fwk_sensor_service:service_manager find;

# Allow to access /dev/dma_heap/system (required for Codec2 buffer mapping)
allow hal_camera_default dmabuf_system_heap_device:chr_file r_file_perms;

# Allow to use the media extractor
allow hal_camera_default mediaextractor_service:service_manager find;
binder_call(hal_camera_default, mediaextractor)
binder_call(mediaextractor, hal_camera_default)
allow mediaextractor hal_camera_default:fd use;
allow mediaextractor hal_camera_default:memfd_file { read write getattr map };
# Allow camera HAL to read buffers from mediaextractor (fixes crash accessing /memfd:MediaBufferGroup)
allow hal_camera_default mediaextractor:fd use;
allow hal_camera_default mediaextractor:memfd_file { read write getattr map };

# Allow setting thread priority (fixes sys_nice denial)
allow hal_camera_default self:capability sys_nice;

# Allow to use the media server (for AMediaCodec)
allow hal_camera_default mediaserver_service:service_manager find;
binder_call(hal_camera_default, mediaserver)
binder_call(mediaserver, hal_camera_default)

# Allow to read codec2 properties
get_prop(hal_camera_default, codec2_config_prop)
get_prop(hal_camera_default, boot_status_prop)

# Silence denials for default_prop (common for media properties without specific contexts)
dontaudit hal_camera_default default_prop:file { read getattr map open };

# Allow to find and use Codec2 services (for software decoders)
hal_client_domain(hal_camera_default, hal_codec2)

# Allow interaction with media_quality (standard for media components)
allow hal_camera_default media_quality_service:service_manager find;

# Standard thread priority and scheduling permissions for media
allow hal_camera_default scheduling_policy_service:service_manager find;
r_dir_file(hal_camera_default, cgroup)
r_dir_file(hal_camera_default, cgroup_v2)

# Allow to interact with mediametrics
allow hal_camera_default mediametrics_service:service_manager find;
binder_call(hal_camera_default, mediametrics)
