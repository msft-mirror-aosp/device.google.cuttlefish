<ExternalCamera>
    <Provider>
        <!-- Ignore internal/dummy video devices (e.g. /dev/video0) so that only -->
        <!-- the emulated cameras (/dev/video1 and etc) are surfaced. -->
        <ignore>
            <id>0</id>
        </ignore>
    </Provider>
    <!-- Device configuration tailored for emulated_camera_mplane (640x480 @ 30fps) -->
    <Device>
        <!-- Max JPEG buffer size in bytes -->
        <MaxJpegBufferSize bytes="460800"/> <!-- ~450KB (~= 640x480 YUV420M) -->

        <!-- Size of v4l2 buffer queue when streaming >= 30fps -->
        <NumVideoBuffers count="4"/>
        <!-- Size of v4l2 buffer queue when still/streaming < 30fps -->
        <NumStillBuffers count="2"/>

        <!-- Supported output resolutions and maximum framerates -->
        <!-- Any image size smaller than or equal to the size listed in the row -->
        <!-- will report fps up to the fpsBound value. -->
        <FpsList>
            <!-- Tailored to match emulated_camera_mplane discrete format (640x480@30fps) -->
            <Limit width="640" height="480" fpsBound="30.0"/>
            <!-- Sizes larger than the last entry (640x480) will not be advertised -->
        </FpsList>
    </Device>
</ExternalCamera>
