{
	"x_res" : 1600,
	"y_res" : 900,
	"dpi" : 160,
	"cpus": 8,
	"memory_mb" : 8192,
	"hwcomposer": "drm_hwcomposer",
	"touchpad": "width=1600,height=900",
	"custom_actions" : [
		{
				"device_states": [
						{
								"lid_switch_open": true,
								"hinge_angle_value": 90
						}
				],
				"button":{
						"command":"open_lid",
						"title":"Open lid",
						"icon_name":"laptop_chromebook"
				}
		},
		{
				"device_states": [
						{
								"lid_switch_open": false,
								"hinge_angle_value": 0
						}
				],
				"button":{
						"command":"close_lid",
						"title":"Close lid",
						"icon_name":"cancel_presentation"
				}
		}
	]
}
