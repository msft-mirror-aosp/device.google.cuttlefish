on post-fs-data
    # It should use init rc commands (e.g. `write ...`) for the operations.
    # However, the command execution from /vendor/etc/init is handled as `vendor_init` and it is
    # restricted from interacting with `shell_data_file` (i.e. /data/local/tmp) by neverallow rules.
    # To bypass the check, it uses `exec` with root permission.
    # The hack is acceptable since Cuttlefish isn't an end-user facing product.
    #
    # The Chrome flag disables sending metrics to the server.
    exec u:r:su:s0 root root -- /system/bin/sh -c "echo 'chrome --metrics-recording-only' > /data/local/tmp/chrome-command-line"
    # Make the file visible from Chrome app.
    exec u:r:su:s0 root root -- /system/bin/sh -c "chmod 644 /data/local/tmp/chrome-command-line"
