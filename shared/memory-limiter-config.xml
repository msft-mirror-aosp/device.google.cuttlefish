<?xml version="1.0" encoding="UTF-8"?>
<MemoryLimiterConfig>
  <version>1</version>
  <configList>
    <!-- RAM minimums here don't use typical round numbers (8, 6, 4) to account
         to account for MemTotal excluding a ~0.5G carveout from physical RAM. -->
    <limitSet>
      <!-- Limits for a device with at least 7.5G of ram: 5G/3G/3G/3G -->
      <minimumRequiredMemTotal>7680</minimumRequiredMemTotal>
      <memVisible>5120</memVisible>
      <memNotVisible>3072</memNotVisible>
      <swapVisible>3072</swapVisible>
      <swapNotVisible>3072</swapNotVisible>
    </limitSet>
    <limitSet>
      <!-- Limits for a device with at least 5.5G of ram: 4G/2G/2G/2G -->
      <minimumRequiredMemTotal>5632</minimumRequiredMemTotal>
      <memVisible>4096</memVisible>
      <memNotVisible>2048</memNotVisible>
      <swapVisible>2048</swapVisible>
      <swapNotVisible>2048</swapNotVisible>
    </limitSet>
    <limitSet>
      <!-- Limits for a device with at least 3.5G of ram: 3G/2G/2G/2G -->
      <minimumRequiredMemTotal>3584</minimumRequiredMemTotal>
      <memVisible>3072</memVisible>
      <memNotVisible>2048</memNotVisible>
      <swapVisible>2048</swapVisible>
      <swapNotVisible>2048</swapNotVisible>
    </limitSet>
  </configList>
</MemoryLimiterConfig>
