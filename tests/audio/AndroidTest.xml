<configuration description="Config for Cuttlefish Audio Focus and E2E test suite">
    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="test-file-name" value="CuttlefishAudioSnippet.apk" />
        <option name="install-arg" value="-r" />
        <option name="install-arg" value="-g" />
    </target_preparer>
    <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
        <option name="mobly-par-file-name" value="cuttlefish-audio-test" />
        <option name="mobly-test-timeout" value="300000" />
        <option name="no-double-dash" value="true" />
    </test>
</configuration>
