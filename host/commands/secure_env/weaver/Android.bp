package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_library_host {
    name: "libweaver_cf",
    srcs: ["lib.rs"],
    crate_name: "weaver_cf",
    rustlibs: [
        "libciborium",
        "libhal_ta",
        "libhal_wire",
        "liblibc",
        "liblog_rust",
        "libnix",
        "libsecure_env_common",
        "libserde",
        "libserde_json",
        "libsubtle",
        "libweaver_ta",
        "libweaver_wire",
        "libzeroize",
    ],
    defaults: ["cuttlefish_buildhost_only"],
    target: {
        darwin: {
            enabled: true,
        },
    },
}

rust_ffi_host {
    name: "libweaver_cf_ffi",
    compile_multilib: "64",
    srcs: ["ffi.rs"],
    crate_name: "weaver_cf_ffi",
    rustlibs: [
        "libweaver_cf",
        "liblibc",
        "liblog_rust",
    ],
    prefer_rlib: true,
    defaults: ["cuttlefish_buildhost_only"],
    target: {
        darwin: {
            enabled: true,
        },
    },
}
