package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.media.c2-service-cuttlefish",
    vendor: true,
    relative_install_path: "hw",

    init_rc: ["android.hardware.media.c2-service-cuttlefish.rc"],
    vintf_fragments: ["manifest_media_c2_cuttlefish.xml"],

    defaults: [
        "libcodec2-aidl-V2-defaults",
    ],

    srcs: [
        "main.cpp",
        "CuttlefishComponentStore.cpp",
    ],

    whole_static_libs: [
        "libcodec2_cuttlefish_hevc_dec",
    ],

    shared_libs: [
        "android.media.swcodec.flags-aconfig-cc",
        "libavservices_minijail",
        "libbase",
        "libbinder_ndk",
        "libcodec2_soft_common",
        "libcodec2_vndk",
        "liblog",
        "libsfplugin_ccodec_utils",
        "libstagefright_foundation",
    ],

    arch: {
        riscv64: {
            enabled: false,
        },
    },

    required: ["android.hardware.media.c2-cuttlefish-seccomp.policy"],
}

prebuilt_etc {
    name: "android.hardware.media.c2-cuttlefish-seccomp.policy",
    vendor: true,
    sub_dir: "seccomp_policy",
    arch: {
        arm: {
            src: "seccomp_policy/cuttlefish-c2-arm.policy",
        },
        arm64: {
            src: "seccomp_policy/cuttlefish-c2-arm64.policy",
        },
        riscv64: {
            enabled: false,
        },
        x86: {
            src: "seccomp_policy/cuttlefish-c2-x86.policy",
        },
        x86_64: {
            src: "seccomp_policy/cuttlefish-c2-x86_64.policy",
        },
    },
}
