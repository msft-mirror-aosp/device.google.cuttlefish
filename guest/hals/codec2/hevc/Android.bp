package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libcodec2_cuttlefish_hevc_dec",
    vendor: true,

    defaults: [
        "libcodec2-aidl-V2-defaults",
    ],

    srcs: [
        "C2CuttlefishHevcDec.cpp",
    ],

    include_dirs: [
        "device/google/cuttlefish/guest/hals/codec2",
    ],

    export_include_dirs: [
        ".",
    ],

    whole_static_libs: [
        "libhevcdec",
    ],

    export_static_lib_headers: [
        "libhevcdec",
    ],

    shared_libs: [
        "android.media.swcodec.flags-aconfig-cc",
        "libbase",
        "libcodec2_soft_common",
        "libcodec2_vndk",
        "liblog",
        "libsfplugin_ccodec_utils",
        "libstagefright_foundation",
    ],
}
