package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "android.hardware.weaver-service.cuttlefish",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["src/main.rs"],
    rustlibs: [
        "android.hardware.weaver-V3-rust",
        "libandroid_logger",
        "libbinder_rs",
        "libhal_hal",
        "liblibc",
        "liblog_rust",
        "libnix",
        "libweaver_hal",
    ],
    init_rc: ["android.hardware.weaver-service.cuttlefish.rc"],
    vintf_fragments: ["android.hardware.weaver-service.cuttlefish.xml"],
}
