soong_namespace {
    imports: [
        "external/wireless-regdb",
    ],
}

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// TODO(b/294888357) this can be removed once mac80211 is removed from first stage init.
prebuilt_firmware {
    name: "wifi-regulatory-fw.vendor_ramdisk",
    licenses: ["wireless-regdb_license"],
    srcs: [
        ":wireless-regdb-prebuilts",
    ],
    vendor_ramdisk: true,
}
