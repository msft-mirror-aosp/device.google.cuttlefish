package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_desktop_display",
}

cc_library_static {
    name: "libvkms_tester",
    vendor_available: true,
    enabled: false,
    target: {
        android_x86_64: {
            enabled: true,
        },
        android_x86: {
            enabled: true,
        },
        linux_glibc_x86_64: {
            enabled: true,
        },
    },
    srcs: [
        "vkms_tester.cpp",
        "edid_helper.cpp",
    ],
    shared_libs: [
        "libbase",
        "libjsoncpp",
        "liblog",
        "libcutils",
    ],
    static_libs: [
        "libcuttlefish_utils",
        "libcuttlefish_fs",
    ],
    export_include_dirs: [
        ".",
    ],
    header_libs: [
        "cuttlefish_common_headers",
    ],
}

cc_binary {
    name: "vkms_controller",
    enabled: false,
    target: {
        android_x86_64: {
            enabled: true,
        },
        android_x86: {
            enabled: true,
        },
    },
    srcs: [
        "main.cpp",
    ],
    shared_libs: [
        "libbase",
        "libjsoncpp",
        "liblog",
        "libcutils",
    ],
    static_libs: [
        "libvkms_tester",
        "libcuttlefish_utils",
        "libcuttlefish_fs",
    ],
    header_libs: [
        "cuttlefish_common_headers",
    ],
    vendor: true,
}

java_test_host {
    name: "CfVkmsControllerTest",
    defaults: [
        "cuttlefish_host_test_utils_defaults",
    ],
    srcs: [
        "CfVkmsControllerTest.java",
    ],
    test_options: {
        unit_test: false,
    },
    test_suites: [
        "device-tests",
    ],
    libs: [
        "compatibility-host-util",
        "cts-tradefed",
        "tradefed",
    ],
}
