package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_prebuilt_library_shared {
    name: "liblitert_dispatch_mock",
    stem: "liblitert_dispatch_mock",
    vendor: true,
    compile_multilib: "first",
    arch: {
        x86: {
            srcs: ["prebuilts/20260828/x86/liblitert_dispatch_mock.so"],
        },
        x86_64: {
            srcs: ["prebuilts/20260828/x86_64/liblitert_dispatch_mock.so"],
        },
        arm64: {
            srcs: ["prebuilts/20260828/arm64/liblitert_dispatch_mock.so"],
        },
    },
    check_elf_files: false,
    strip: {
        none: true,
    },
}

prebuilt_etc {
    name: "npu_test_model.tflite",
    src: "testdata/TestMobileNetV2.tflite",
    filename_from_src: true,
    sub_dir: "npu/testdata",
    vendor: true,
}

prebuilt_etc {
    name: "npu_test_input.inp",
    src: "testdata/TestMobileNetV2.inp",
    filename_from_src: true,
    sub_dir: "npu/testdata",
    vendor: true,
}

prebuilt_etc {
    name: "npu_test_output.ref",
    src: "testdata/TestMobileNetV2.out.ref",
    filename_from_src: true,
    sub_dir: "npu/testdata",
    vendor: true,
}

prebuilt_etc {
    name: "npu_test_config.textproto",
    src: "testdata/TestMobileNetV2.textproto",
    filename_from_src: true,
    sub_dir: "npu/testdata",
    vendor: true,
}
